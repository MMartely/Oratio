# Copie ce fichier en .env.local pour brancher Supabase en local.
# Sans ces deux valeurs, l'application tourne en mode démo (données sur l'appareil, coach simulé).
# La clé « anon » est publique par conception : la sécurité repose sur les règles de la base.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
